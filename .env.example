# Copy this file to .env and fill in your keys.

# --- Native (iOS/Android via Expo Go or a dev build) ---
# These get compiled into the app bundle and called directly from the device,
# so CORS doesn't apply there. Do NOT rely on these for the web build (see
# below) — a browser can read them straight out of the public JS bundle.

# CoinGecko free "Demo" key is optional — crypto works without one, just at a
# lower rate limit. Get one at https://www.coingecko.com/en/developers/dashboard
EXPO_PUBLIC_COINGECKO_API_KEY=

# Required for stock data. Free key from https://finnhub.io/register
EXPO_PUBLIC_FINNHUB_API_KEY=

# --- Web (npm run build:web / npm run serve:web) ---
# The website calls CoinGecko/Finnhub/Yahoo Finance through same-origin proxy
# routes (app/api/**/+api.ts) instead of directly from the browser, both to
# avoid CORS and to keep these keys out of the public web bundle. Set these
# as plain server environment variables wherever you host server.js — do NOT
# prefix them with EXPO_PUBLIC_, or they'll leak into the client bundle too.
COINGECKO_API_KEY=
FINNHUB_API_KEY=
